---
/**
 * Static game catalog with progressively enabled category and publisher filters.
 */
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const db = getDatabase();
const games = await getAllGames(db);
const categories = await getAllCategories(db);
const publishers = await getAllPublishers(db);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div id="game-catalog">
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      <fieldset id="game-filters" disabled class="bg-slate-800 rounded-xl border border-slate-700 p-6 mb-6">
        <legend class="text-lg font-medium text-slate-100 px-2">Filter games</legend>
        <fieldset class="mb-4">
          <legend class="text-slate-200 font-medium mb-2">Categories</legend>
          <p id="category-filter-help" class="text-sm text-slate-300 mb-3">Match any selected category, or leave all unchecked to show every category.</p>
          <div class="flex flex-wrap gap-4">
            {categories.map((category) => (
              <label class="flex items-center gap-2 text-slate-100" for={`category-${category.id}`}>
                <input
                  id={`category-${category.id}`}
                  type="checkbox"
                  name="category"
                  value={category.id}
                  aria-describedby="category-filter-help"
                  data-testid={`category-filter-${category.id}`}
                  class="h-4 w-4 accent-blue-500 rounded focus:ring-2 focus:ring-blue-500 focus:outline-none"
                />
                {category.name}
              </label>
            ))}
          </div>
        </fieldset>
        <div class="flex flex-col sm:flex-row sm:items-end gap-4">
          <div class="flex flex-col gap-2">
            <label for="publisher-filter" class="text-slate-200 font-medium">Publisher</label>
            <select id="publisher-filter" data-testid="publisher-filter" class="w-full sm:w-auto bg-slate-900 text-slate-100 border border-slate-600 rounded-lg p-2 focus:ring-2 focus:ring-blue-500 focus:outline-none">
              <option value="">All publishers</option>
              {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
            </select>
          </div>
          <button id="clear-filters" type="button" data-testid="clear-filters" class="bg-slate-700 text-slate-100 rounded-lg px-4 py-2 hover:bg-slate-600 transition-colors focus:ring-2 focus:ring-blue-500 focus:outline-none">Clear filters</button>
        </div>
        <p id="filter-script-help" class="text-slate-300 mt-4">Enable JavaScript to filter games. The full catalog is available below.</p>
      </fieldset>
      <p id="filter-result-count" role="status" aria-live="polite" aria-atomic="true" data-testid="filter-result-count" class="text-slate-300 mb-4">
        {games.length} {games.length === 1 ? 'game' : 'games'} found
      </p>
      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => (
              <div data-filter-card data-category-id={game.category?.id} data-publisher-id={game.publisher?.id}>
                <GameCard game={game} />
              </div>
            ))}
          </div>
          <div id="filter-empty-state" hidden>
            <EmptyState text="No games match your filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const catalog = document.querySelector<HTMLElement>('#game-catalog');
  if (!catalog) throw new Error('Game catalog is missing.');

  const filters = catalog.querySelector<HTMLFieldSetElement>('#game-filters');
  const publisher = catalog.querySelector<HTMLSelectElement>('#publisher-filter');
  const clear = catalog.querySelector<HTMLButtonElement>('#clear-filters');
  const count = catalog.querySelector<HTMLElement>('#filter-result-count');
  const scriptHelp = catalog.querySelector<HTMLElement>('#filter-script-help');
  if (!filters || !publisher || !clear || !count || !scriptHelp) {
    throw new Error('Game filter controls are missing.');
  }

  const categories = filters.querySelectorAll<HTMLInputElement>('input[name="category"]');
  const cards = catalog.querySelectorAll<HTMLElement>('[data-filter-card]');
  const emptyState = catalog.querySelector<HTMLElement>('#filter-empty-state');

  const updateResults = (): void => {
    const selectedCategories = new Set(
      Array.from(categories).filter((category) => category.checked).map((category) => category.value),
    );
    let matches = 0;
    for (const card of cards) {
      const categoryMatches = selectedCategories.size === 0 ||
        selectedCategories.has(card.dataset.categoryId ?? '');
      const publisherMatches = publisher.value === '' ||
        card.dataset.publisherId === publisher.value;
      const visible = categoryMatches && publisherMatches;
      card.hidden = !visible;
      if (visible) matches++;
    }
    count.textContent = `${matches} ${matches === 1 ? 'game' : 'games'} found`;
    if (emptyState) emptyState.hidden = matches !== 0;
  };

  filters.addEventListener('change', updateResults);
  clear.addEventListener('click', () => {
    for (const category of categories) category.checked = false;
    publisher.value = '';
    updateResults();
  });
  window.addEventListener('pageshow', updateResults);
  updateResults();
  filters.disabled = false;
  scriptHelp.hidden = true;
</script>
